# Copy this file to `.env` (or `.env.local`) and fill in your Supabase project values.
# Supabase Dashboard > Project Settings > API Keys (or `npx supabase status` for the local stack).
#
# Only CLIENT-SAFE values belong here. EXPO_PUBLIC_* variables are embedded in the app bundle.
# NEVER put the service_role / secret key in this file or anywhere in the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_...). A legacy "anon" JWT key also works here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
